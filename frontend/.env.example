# Diagnostics/Export feature flag
# Set to true to enable the /diagnostics/export page in development
VITE_DIAGNOSTICS_EXPORT_ENABLED=true

# Screenshot stub flag — not implemented in MVP, do not set to true
VITE_DIAGNOSTICS_EXPORT_SCREENSHOTS_ENABLED=false

# Allow diagnostics in production — disabled by default for safety
VITE_DIAGNOSTICS_EXPORT_ALLOW_PROD=false
